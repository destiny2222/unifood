{
  "info": {
    "_postman_id": "b2b-trade-api-collection-id",
    "name": "Mightyolu B2B Trade API",
    "description": "Collection of all API endpoints for Mightyolu B2B Trade Accounts, including Authentication, KYC onboarding, Authorized Buyers, Cart, and Checkout flows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "B2B User Registration",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.token) {",
                  "    pm.collectionVariables.set(\"token\", response.token);",
                  "    console.log(\"Saved registration token to collection variable: \" + response.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"SecurePassword123!\",\n  \"password_confirmation\": \"SecurePassword123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/b2b/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "b2b",
                "register"
              ]
            }
          },
          "response": []
        },
